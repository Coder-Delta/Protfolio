# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# Server
PORT=5000
NODE_ENV=development

# Frontend URL for CORS. Use https://ranjitbhandary.me in production.
FRONTEND_URL=http://localhost:5173

# GitHub project discovery (optional token increases GitHub API rate limits)
GITHUB_USERNAME=Coder-Delta
GITHUB_TOKEN=
GITHUB_SYNC_INTERVAL_MS=300000

# Private analytics dashboard authentication. Use long, unique values in production.
ANALYTICS_ADMIN_PASSWORD=change-this-to-a-long-unique-password
ANALYTICS_ADMIN_TOKEN_SECRET=change-this-to-a-separate-long-random-secret
ANALYTICS_CONSENT_VERSION=1
ANALYTICS_IP_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=365
